@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ruang Rasa Coffee Shop | Artisan Coffee & Dine-In</title>
    <meta name="description" content="Aplikasi Web Coffee Shop Ruang Rasa dengan sistem reservasi meja, katalog menu artisan, dan pemesanan multi-role.">
    <!-- Google Fonts & Material Symbols Rounded -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
    <!-- Leaflet.js CSS untuk Peta OpenStreetMap -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="/client/css/style.css?v=@DateTime.UtcNow.Ticks">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22 fill=%22%23b87d4b%22><path d=%22M2 21v-2h18v2H2Zm2-4q-.825 0-1.412-.587T2 15V5q0-.825.587-1.412T4 3h14q0-.425.288-.712T19 2t.713.288T20 3h1q.825 0 1.413.588T23 5v4q0 .825-.587 1.413T21 11h-3v4q0 .825-.587 1.413T16 17H4Zm14-8h3V5h-3v4Z%22/></svg>">
</head>
<body>
    <!-- 1. Header & Navigation Root -->
    <div id="navbar-root"></div>

    <!-- 2. Main Page Dynamic Content -->
    <main id="page-root">
        <div style="text-align:center; padding: 5rem 1rem; color: var(--text-muted);">
            <p>Memuat Ruang Rasa...</p>
        </div>
    </main>

    <!-- 3. Modals Root -->
    <div id="cart-modal-root"></div>
    <div id="table-modal-root"></div>

    <!-- 4. Footer -->
    <footer style="border-top: 1px solid var(--border-subtle); padding: 3rem 1rem; text-align: center; color: var(--text-muted); font-size: 0.86rem; margin-top: 4rem; background: var(--bg-surface);">
        <div class="container">
            <div style="display:flex; justify-content:center; align-items:center; gap:0.5rem; margin-bottom:0.5rem; font-weight:700; color:var(--text-heading);">
                <span class="material-symbols-rounded" style="color:var(--primary);">local_cafe</span>
                <span>Ruang Rasa Coffee Shop</span>
            </div>
            <p>&copy; 2026 Ruang Rasa - Tugas Akhir & Proyekan S1. Fullstack ASP.NET Web Application.</p>
        </div>
    </footer>

    <!-- External Map Library (Leaflet.js) -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- Core Scripts -->
    <script src="/client/js/api.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="/client/js/toast.js?v=@DateTime.UtcNow.Ticks"></script>
    
    <!-- Components -->
    <script src="/client/js/components/navbar.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="/client/js/components/table-picker.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="/client/js/components/cart-modal.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="/client/js/components/custom-select.js?v=@DateTime.UtcNow.Ticks"></script>

    <!-- Pages -->
    <script src="/client/js/pages/home.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="/client/js/pages/products.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="/client/js/pages/cart.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="/client/js/pages/login.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="/client/js/pages/register.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="/client/js/pages/forgot-password.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="/client/js/pages/dashboard.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="/client/js/pages/menu-crud.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="/client/js/pages/table-management.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="/client/js/pages/promo-crud.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="/client/js/pages/tracking.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="/client/js/pages/profile.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="/client/js/pages/error-pages.js?v=@DateTime.UtcNow.Ticks"></script>

    <!-- Router & App Initializer -->
    <script src="/client/js/router.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="/client/js/app.js?v=@DateTime.UtcNow.Ticks"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            App.init();
        });
    </script>
</body>
</html>