  <diagram id="p6" name="6. Live Tracking &amp; Komunikasi Kurir">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1470" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p6_title" value="ALUR LIVE TRACKING DELIVERY (GPS + OSRM) &amp; KOMUNIKASI KURIR ↔ PELANGGAN" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#382418;fontSize=19;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="14" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p6_sub" value="Sisi driver (kiri), server (tengah), pelanggan (kanan) — plus modul driver-comm.js di bagian bawah" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#475569;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="52" width="1200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p6_d1" value="Driver menekan 'Mulai antar'&#10;(status Delivering)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#382418;strokeColor=#382418;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p6_d2" value="navigator.geolocation.watchPosition()&#10;mengirim posisi setiap beberapa detik" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B87333;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6_d3" value="POST /tracking/update&#10;{ OrderNumber, DriverId, Latitude, Longitude }" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B87333;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="370" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6_d4" value="Peta driver: marker kurir + rute jalan OSRM&#10;simulasi lalu lintas Bandung (hijau/kuning/merah)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B87333;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p6_d5" value="Sampai di alamat?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="650" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p6_d6" value="POST /orders/{id}/status&#10;→ status Delivered" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B87333;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="820" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6_d7" value="Serah terima &amp; konfirmasi diterima&#10;→ status Completed" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B87333;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="950" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6_d8" value="Pengantaran selesai" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2F4F3A;strokeColor=#2F4F3A;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="1080" width="280" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p6_s1" value="RuangrasaApiController&#10;POST /tracking/update → SaveDriverLocation()" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B87333;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1">
