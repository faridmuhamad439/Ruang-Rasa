        </mxCell>
        <mxCell id="p3_cancel" value="Batal / ditolak&#10;POST /orders/{id}/cancel → status Cancelled,&#10;meja Available, stok menu dikembalikan" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=10;" vertex="1" parent="1">
