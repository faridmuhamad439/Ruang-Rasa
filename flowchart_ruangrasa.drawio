        <mxCell id="p4_te" value="E. VALIDASI FORM DAFTAR &amp; MASUK — 3 LAPIS (CLIENT → DATAANNOTATIONS → SERVICE)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#382418;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1760" width="1700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p4_v0" value="Pengguna mengisi form&#10;(#/register atau #/login)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B87333;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="1810" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4_v1" value="LAPIS 1 — CLIENT&#10;App.validateInput() di js/app.js&#10;(toast + pesan .invalid-feedback)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="1930" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4_vd1" value="Nama lengkap valid?&#10;min 3 huruf, hanya huruf&#10;TANPA batas maksimum" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="1900" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4_vd2" value="Email valid?&#10;nama@domain.tld&#10;(TLD min. 2 huruf)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="1900" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4_vd3" value="Telepon Indonesia valid?&#10;08xx / +628xx, 9-14 digit&#10;prefix provider dikenal" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="970" y="1900" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4_vd4" value="Kata sandi kuat?&#10;min 8 + huruf besar/kecil/angka&#10;TANPA batas maksimum" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1290" y="1900" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4_v2" value="LAPIS 2 — MODEL&#10;DataAnnotations kustom:&#10;[FullName], [EmailAddress],&#10;[IndonesianPhone], [StrongPassword],&#10;[Compare] (LoginRequest.cs)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="2120" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4_v3" value="LAPIS 3 — SERVICE&#10;Guard manual di RuangrasaService:&#10;IsFullNameValid, IsEmailValid,&#10;IsIndonesianPhoneValid, IsStrongPasswordValid" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="2120" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4_v4" value="Valid → buat akun (BCrypt)&#10;atau sesi JWT diterbitkan" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="2150" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4_v5" value="Invalid → HTTP 400 + pesan&#10;spesifik per field, toast error" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1370" y="2150" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4_vn1" value="Prefix provider yang dikenal (3 digit setelah 0):&#10;Telkomsel &amp; By.U: 811 812 813 821 822 851 852 853&#10;Indosat Ooredoo: 814 815 816 855 856 857 858&#10;XL Axiata: 817 818 819 859 877 878&#10;Smartfren: 881-889&#10;Tri (3): 894-899" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;verticalAlign=middle;align=left;fontColor=#1F2937;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1660" y="1900" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p4_vn2" value="Login hanya memvalidasi keberadaan isian; kebijakan kompleksitas sandi diterapkan saat pendaftaran, reset password, dan ganti sandi. Sandi 253 karakter tetap diterima (tanpa maksimum)." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;verticalAlign=middle;align=left;fontColor=#1F2937;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1660" y="2090" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p4_vn3" value="Meter kekuatan sandi live di form daftar &amp; reset: merah (lemah) → kuning (sedang) → hijau (kuat/sangat kuat) berdasarkan 4 syarat yang terpenuhi." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;verticalAlign=middle;align=left;fontColor=#1F2937;fontSize=9;" vertex="1" parent="1">
