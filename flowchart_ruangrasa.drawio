        </mxCell>
        <mxCell id="p4_a3" value="Kredensial valid?&#10;(BCrypt.Verify)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="310" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4_a4" value="Tampilkan error + toast&#10;(email / kata sandi salah)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="310" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4_a5" value="Buat access token JWT (HS256) + refresh token&#10;claims: userId, fullName, email, role, exp" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=11;" vertex="1" parent="1">
