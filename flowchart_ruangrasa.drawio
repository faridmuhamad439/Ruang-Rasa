        <mxCell id="p3_s8" value="Pantau status &amp; peta kurir&#10;#/tracking?order=RR-... (polling posisi kurir)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B87333;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="1600" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3_s9" value="Terima pesanan → rating 1-5 &amp; ulasan&#10;POST /orders/{id}/review (status Completed)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B87333;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="1720" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3_s10" value="Selesai — transaksi ditutup" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2F4F3A;strokeColor=#2F4F3A;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="1840" width="260" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p3_n1" value="Aturan tamu (guest): hanya boleh Dine-In, wajib mengisi nama pemesan dan memilih meja kosong." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;verticalAlign=middle;align=left;fontColor=#1F2937;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1260" y="560" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3_n2" value="Aturan delivery: wajib pembayaran non-tunai di muka (QRIS / Transfer / Kartu)." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;verticalAlign=middle;align=left;fontColor=#1F2937;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1260" y="670" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3_n3" value="Perhitungan biaya dilakukan di server: total = (subtotal − diskon) + PPN 10% + ongkos kirim (batas wajar tarif kurir ≤ Rp 25.000)." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;verticalAlign=middle;align=left;fontColor=#1F2937;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1260" y="770" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3_n4" value="Nomor pesanan memakai pola RR-YYYYMMDD-000N (MAX-based sequence untuk menghindari race condition)." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;verticalAlign=middle;align=left;fontColor=#1F2937;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1260" y="890" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3_n5" value="Meja otomatis menjadi Occupied saat pesanan Dine-In dibuat; kembali Available ketika pesanan dibatalkan atau meja dibersihkan." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;verticalAlign=middle;align=left;fontColor=#1F2937;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1000" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3_n6" value="Semua request memakai header Authorization: Bearer &lt;JWT&gt; yang disimpan di localStorage setelah login." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;verticalAlign=middle;align=left;fontColor=#1F2937;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1110" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3_n7" value="Endpoint halaman ini: /promos/validate, /payment/*, /orders, /orders/{id}/review, /tracking/latest/{orderId}." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;verticalAlign=middle;align=left;fontColor=#1F2937;fontSize=10;" vertex="1" parent="1">
