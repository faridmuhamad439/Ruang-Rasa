        <mxCell id="p4_a1" value="Akses halaman #/login" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#382418;strokeColor=#382418;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="260" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p4_a2" value="Isi email &amp; kata sandi" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B87333;strokeWidth=2;verticalAlign=middle;align=center;fontColor=#1F2937;fontSize=12;" vertex="1" parent="1">
