  <diagram id="p4" name="4. Autentikasi &amp; RBAC">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="2380" math="0" shadow="0">
