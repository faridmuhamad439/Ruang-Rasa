      "item": [
        {
          "name": "Login User (Dapatkan JWT Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"Email\": \"admin@ruangrasa.com\",\n    \"Password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Autentikasi akun pengguna (Admin, Owner, Kasir, Dapur, Waiter, Driver, Customer) dan menghasilkan JWT Bearer Token serta Refresh Token."
